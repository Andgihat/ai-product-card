# ─── Подключение LLM ────────────────────────────────────────────────────────
# Сервису нужны три переменные: LLM_BASE_URL, LLM_MODEL и LLM_API_KEY.
# Ниже готовые блоки. Оставьте активным один — остальные закомментируйте.

# --- Локальная модель: llama.cpp / LM Studio (ключ не нужен) ---------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
LLM_API_KEY=not-needed

# --- Ollama ----------------------------------------------------------------
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=not-needed

# --- DeepSeek --------------------------------------------------------------
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=

# --- OpenAI ----------------------------------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# --- Google Gemini (OpenAI-совместимый режим) ------------------------------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=

# --- OpenRouter ------------------------------------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_KEY=

# ─── Параметры генерации ────────────────────────────────────────────────────
# Таймаут одного запроса, секунды.
LLM_TIMEOUT=900
# Температура: ниже — стабильнее, выше — живее текст.
LLM_TEMPERATURE=0.4
# Бюджет ответа. У моделей с reasoning размышления тратят его до JSON,
# поэтому нужен запас: 16k хватает и локальным, и облачным моделям.
LLM_MAX_TOKENS=16384
# Повторы при 429/5xx и таймаутах.
LLM_RETRIES=2

# ─── Второй проход: проверка прозы отдельной моделью ────────────────────────
# Ищет в описании и коммерческом блоке утверждения, которых нет во входных
# данных. Удваивает время генерации, поэтому по умолчанию выключен.
VERIFY_LLM=false
# Модель-фактчекер. Пусто — используется LLM_MODEL.
# Лучше указать другую модель: та же склонна подтверждать собственный текст.
VERIFIER_MODEL=
